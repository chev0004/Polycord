{
  "name": "polycord",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "fix:all": "biome check --write --formatter-enabled=true && biome format --write",
    "check:all": "biome check --linter-enabled=true --formatter-enabled=true && bun scripts/check-i18n.ts && bun run typecheck",
    "check:i18n": "bun scripts/check-i18n.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local drizzle-kit migrate",
    "db:studio": "bun --env-file=.env.local drizzle-kit studio",
    "gen:locales": "node generate-locales.mjs",
    "storybook": "bun run gen:locales && storybook dev -p 6006",
    "build-storybook": "bun run gen:locales && storybook build",
    "prepare": "husky",
    "tickets": "bun --env-file=.env.local tsx scripts/tickets.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "biome format --write",
      "biome lint --write"
    ]
  },
  "dependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-virtual": "^3.13.12",
    "drizzle-orm": "^0.45.2",
    "ffprobe-static": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "next": "^15.5.4",
    "next-intl": "^4.3.12",
    "postgres": "^3.4.9",
    "radix-ui": "^1.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.65.0",
    "react-icons": "^5.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@chromatic-com/storybook": "^3.2.4",
    "@notionhq/client": "^5.22.0",
    "@storybook/addon-essentials": "^8.5.3",
    "@storybook/addon-interactions": "^8.5.3",
    "@storybook/addon-onboarding": "^8.5.3",
    "@storybook/blocks": "^8.5.3",
    "@storybook/nextjs": "^8.5.3",
    "@storybook/react": "^8.5.3",
    "@storybook/test": "^8.5.3",
    "@types/country-list": "^2.1.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8",
    "storybook": "^8.5.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "webpack": "5.101.2"
  }
}
