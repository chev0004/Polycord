+import { NextResponse } from 'next/server';
+import { Client } from 'pg';
+import { connectionConfig } from '@/db/connection';
+import { serialized } from '@/lib/disc031';
+import {
+  BAN_CHECK_AUTH_HEADER,
+  isBanCheckToken,
+  readSessionFromCookieValue,
+} from './auth-session';
+import { traceEnabled } from './disc031';
+import payloads from './disc031Payloads.json';
+
+export const experimentResponse = async (
+  request: Request,
+  name: 'viewer' | 'discovery',
+) => {
+  const mode = request.headers.get('x-disc031-control');
+  if (!traceEnabled || !mode || mode === 'real') return null;
+  if (
+    process.env.DISC031_SITE !== '0c36e849-7617-4665-a657-1eb2b60da3d2' ||
+    !new URL(process.env.DATABASE_URL as string).username.endsWith(
+      '.vioatoyjsfzqrpohliaa',
+    ) ||
+    !(await isBanCheckToken(request.headers.get(BAN_CHECK_AUTH_HEADER)))
+  ) {
+    return NextResponse.json(
+      { error: 'Forbidden' },
+      { status: 403, headers: { 'Cache-Control': 'private, no-store' } },
+    );
+  }
+  const cookie = request.headers
+    .get('cookie')
+    ?.match(/(?:^|;\s*)polycord_session=([^;]+)/)?.[1];
+  const session = cookie ? await readSessionFromCookieValue(cookie) : null;
+  if (cookie && session?.id !== 'test006-allowed') {
+    return NextResponse.json(
+      { error: 'Forbidden' },
+      { status: 403, headers: { 'Cache-Control': 'private, no-store' } },
+    );
+  }
+  if (mode === 'select1') {
+    const client = new Client({ ...connectionConfig(), query_timeout: 10000 });
+    try {
+      await client.connect();
+      await client.query('select 1');
+    } finally {
+      await client.end();
+    }
+  } else if (mode !== 'fixed') {
+    return NextResponse.json(
+      { error: 'Invalid control' },
+      { status: 400, headers: { 'Cache-Control': 'private, no-store' } },
+    );
+  }
+  const data =
+    name === 'viewer'
+      ? session
+        ? payloads.viewer
+        : { isLoggedIn: false }
+      : new URL(request.url).searchParams.get('count') === '1'
+        ? { total: 4735 }
+        : payloads.discovery;
+  return serialized(() =>
+    NextResponse.json(data, {
+      headers: { 'Cache-Control': 'private, no-store' },
+    }),
+  );
+};
