@@ -0,0 +1,126 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+
+export const traceEnabled = process.env.DISC031_TIMING === 'true';
+const instance = crypto.randomUUID();
+const moduleAt = Date.now();
+type Span = { name: string; start: number; ms: number };
+type Trace = { id: string; at: number; spans: Span[]; children: unknown[] };
+const storage = new AsyncLocalStorage<Trace>();
+
+export const startSpan = (name: string) => {
+  const trace = storage.getStore();
+  const start = performance.now();
+  return () =>
+    trace?.spans.push({
+      name,
+      start: start - trace.at,
+      ms: performance.now() - start,
+    });
+};
+
+export const timedMethod = <T extends (...args: never[]) => unknown>(
+  name: string,
+  method: T,
+): T =>
+  new Proxy(method, {
+    apply(target, receiver, args) {
+      const text = typeof args[0] === 'string' ? args[0] : args[0]?.text;
+      const verb =
+        typeof text === 'string'
+          ? text.trim().split(/\s/, 1)[0].toLowerCase()
+          : '';
+      const finish = startSpan(
+        name === 'sql' &&
+          ['select', 'begin', 'commit', 'rollback'].includes(verb)
+          ? `sql-${verb}`
+          : name,
+      );
+      const callback = args.at(-1);
+      if (typeof callback === 'function') {
+        args[args.length - 1] = (...values: unknown[]) => {
+          finish();
+          return callback(...values);
+        };
+        return Reflect.apply(target, receiver, args);
+      }
+      const result = Reflect.apply(target, receiver, args);
+      if (result?.then) return result.finally(finish);
+      finish();
+      return result;
+    },
+  });
+
+export const span = async <T>(name: string, operation: () => Promise<T>) => {
+  const trace = storage.getStore();
+  if (!trace) return operation();
+  const start = performance.now();
+  try {
+    return await operation();
+  } finally {
+    trace.spans.push({
+      name,
+      start: start - trace.at,
+      ms: performance.now() - start,
+    });
+  }
+};
+
+export const childTrace = (response: Response) => {
+  const value = response.headers.get('x-disc031');
+  if (value) storage.getStore()?.children.push(JSON.parse(value));
+  const runtime = response.headers.get('x-disc031-runtime');
+  if (runtime) storage.getStore()?.children.push(JSON.parse(runtime));
+};
+
+export const traceId = () => storage.getStore()?.id ?? crypto.randomUUID();
+
+export const serialized = <T>(operation: () => T): T => {
+  const finish = startSpan('serialization');
+  try {
+    return operation();
+  } finally {
+    finish();
+  }
+};
+
+export const traced = async <T extends Response>(
+  name: string,
+  request: Request,
+  operation: () => Promise<T>,
+): Promise<T> => {
+  if (!traceEnabled) return operation();
+  const supplied = request.headers.get('x-disc031-id');
+  const trace: Trace = {
+    id:
+      supplied && /^[a-f0-9-]{36}$/.test(supplied)
+        ? supplied
+        : crypto.randomUUID(),
+    at: performance.now(),
+    spans: [],
+    children: [],
+  };
+  return storage.run(trace, async () => {
+    const response = await span(name, operation);
+    const headers = new Headers(response.headers);
+    headers.set(
+      ['middleware', 'document'].includes(name)
+        ? 'x-disc031-edge'
+        : 'x-disc031',
+      JSON.stringify({
+        id: trace.id,
+        name,
+        instance,
+        moduleAge: Date.now() - moduleAt,
+        runtime: 'Deno' in globalThis ? 'deno' : process.version,
+        transport:
+          process.env.POLYCORD_DIRECT_BAN_CHECK === 'true' ? 'direct' : 'https',
+        spans: trace.spans,
+        children: trace.children,
+      }),
+    );
+    return new Response(response.body, {
+      status: response.status,
+      headers,
+    }) as T;
+  });
+};
