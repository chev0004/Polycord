POLYCORD_RATE_LIMIT_BUMP=
POLYCORD_RATE_LIMIT_COPY=
POLYCORD_RATE_LIMIT_AUTH_FAILURE=
# Stripe billing (leave unset to disable subscription management)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
