      "checkConstraints": {
        "profiles_bio_length_check": {
          "name": "profiles_bio_length_check",
          "value": "char_length(\"profiles\".\"bio\") between 10 and 500"
        },
        "profiles_availability_check": {
          "name": "profiles_availability_check",
          "value": "\"profiles\".\"availability\" in ('weeknights', 'weekends', 'weekday_mornings', 'flexible')"
        },
        "profiles_availability_days_check": {
          "name": "profiles_availability_days_check",
          "value": "\"profiles\".\"availability_days\" is null or \"profiles\".\"availability_days\" in ('any', 'weekdays', 'weekends')"
        },
        "profiles_availability_from_check": {
          "name": "profiles_availability_from_check",
          "value": "\"profiles\".\"availability_from\" is null or \"profiles\".\"availability_from\" ~ '^[0-2][0-9]:[0-5][0-9]$'"
        },
        "profiles_availability_to_check": {
          "name": "profiles_availability_to_check",
          "value": "\"profiles\".\"availability_to\" is null or \"profiles\".\"availability_to\" ~ '^[0-2][0-9]:[0-5][0-9]$'"
        },
        "profiles_tags_limit_check": {
          "name": "profiles_tags_limit_check",
          "value": "cardinality(\"profiles\".\"tags\") <= 6"
        }
      },
